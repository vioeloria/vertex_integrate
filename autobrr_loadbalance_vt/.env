# ===========================================
# Vertex 连接配置（唯一连接方式）
# ===========================================

# Vertex 服务地址（必需）
VTURL=http://23.82.99.203:3079

# Vertex Cookies（可选，首次冷启动兜底；配置了自动登录后建议留空）
VTCOOKIES=

# ── Vertex 自动登录刷新（可选）──────────────
# 配置后 Cookie 失效时会自动重新登录，无需手动替换
# 登录用户名
VT_USERNAME=admin
# 登录密码（MD5 形式，与接口 payload 的 password 字段格式一致）
VT_PASSWORD_MD5=
# Cookie 有效性探测最小间隔（秒），默认 300s = 5 分钟
VT_COOKIE_CHECK_INTERVAL=300

# ── VT 代理 ID 列表（逗号分隔）──────────────
# 只需填写代理 ID，系统会自动生成完整代理 URL: {VTURL}/proxy/client/{proxy_id}
# 例如: 1043dd9e 会自动转换为 http://23.82.99.203:3079/proxy/client/1043dd9e
VT_PROXIES=

# ===========================================
# 服务器选择策略
# ===========================================
# 可选值:
# - upload_speed  : 选择上传速度最低的服务器（推荐）
# - torrent_count : 选择种子数最少的服务器
# - free_space    : 选择剩余空间最大的服务器
# - all           : 综合评分
SELECT_STRATEGY=upload_speed
FETCH_TIMEOUT=2

# ===========================================
# 重试配置
# ===========================================
# 最大重试次数（推送失败后尝试次数）
MAX_RETRIES=3

# 重试间隔（秒）
RETRY_DELAY=5

# ===========================================
# Telegram 通知配置（可选）
# ===========================================
# Telegram Bot Token（从 @BotFather 获取）
TG_BOT_TOKEN=

# Telegram Chat ID（你的用户 ID 或群组 ID）
TG_CHAT_ID=

# ===========================================
# Webhook 与安全
# ===========================================
# Webhook 访问路径（不要以 / 开头）
# 完整访问地址为: http://your-server:5000/<WEBHOOK_PATH>
WEBHOOK_PATH=webhook/secure-xxxxxxxxxxxxxxxxxx
ADMIN_SECRET=xxxxxxxxxxxxxxxxxx

# ===========================================
# 服务配置
# ===========================================
# Flask 运行端口
FLASK_PORT=5032

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO